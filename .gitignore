# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.pyc

# Environment & Credentials
.env
env/credentials.json
env/token.json
# But keep the example file
!env/.env.example
# Ignore everything else in env folder
env/*
!env/.env.example

# Logs & Temporary processing directories
data/logs/*
!data/logs/.gitkeep
data/database/*.sqlite3
data/database/*.sqlite3-*
email_data/generated_emails/*
!email_data/generated_emails/.gitkeep
email_data/email_attachments/*
!email_data/email_attachments/.gitkeep
*.pdf
