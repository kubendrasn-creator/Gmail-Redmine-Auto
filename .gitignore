# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.pyc

# Environment & Credentials
.env
env/credentials.json
env/token.json
# But keep the example file
!env/.env.example
# Ignore everything else in env folder
env/*
!env/.env.example

# Logs & Temporary processing directories
data/logs/*
!data/logs/.gitkeep
generated_emails/*
!generated_emails/.gitkeep
email_attachments/*
!email_attachments/.gitkeep
temp_attachments/*
!temp_attachments/.gitkeep
*.pdf
