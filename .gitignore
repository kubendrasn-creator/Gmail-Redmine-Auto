# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.pyc

# Environment & Credentials
.env
env/credentials.json
env/token.json
# But keep the example file
!env/.env.example
# Ignore everything else in env folder
env/*
!env/.env.example
!env/config/
env/config/*
!env/config/*.example.json
!env/config/*.example.yaml

# Logs & Temporary processing directories
data/logs/*
!data/logs/.gitkeep
data/database/*.sqlite3
data/database/*.sqlite3-*
data/database/processed_messages.json
data/generated_emails/*
!data/generated_emails/.gitkeep
data/email_attachments/*
!data/email_attachments/.gitkeep
*.pdf
