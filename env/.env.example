# Redmine Configuration
REDMINE_URL=https://your-redmine-instance.com
REDMINE_API_KEY=your_api_key
REDMINE_PROJECT_ID=1
REDMINE_SUPPORT_TRACKER_ID=1
# Fallback assignee's Redmine user ID; used when no mapped person is identified.
REDMINE_ASSIGNEE_ID=1

# Custom Fields (optional)
REDMINE_SEVERITY_CUSTOM_FIELD_ID=2
REDMINE_SEVERITY_VALUE=Normal
# Category IDs and module names/custom-field ID are in this JSON file.
TICKET_FIELDS_FILE=env/config/ticket_fields.json

REDMINE_ESTIMATED_HOURS=0
REDMINE_START_DATE=
REDMINE_END_DATE=

# Gmail Configuration
GMAIL_MAX_RESULTS=10
GMAIL_LOOKBACK_HOURS=24
GMAIL_ALLOWED_SENDERS=user1@example.com,user2@example.com

# AI Classification Configuration (Optional but Recommended)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
AI_MAX_INPUT_CHARS=6000
# Gemini thinking token budget for each classification request (bounded to control cost).
AI_THINKING_BUDGET=1024

# Strip standard signatures, group footers, and confidentiality boilerplate from AI/PDF text.
STRIP_BOILERPLATE=true

# Optional Redmine center/customer custom field. Center takes precedence over enterprise fallback.
REDMINE_CENTER_CUSTOM_FIELD_ID=
# Tracker ID used for feedback tickets. The review UI always offers both ticket types.
REDMINE_FEEDBACK_TRACKER_ID=4
# Cache Redmine custom-field metadata for this many minutes.
REDMINE_METADATA_TTL_MIN=60

# Assignee names and Redmine user IDs; edit env/config/people.json.
PEOPLE_FILE=env/config/people.json
# Words used to identify the person asked to own or act on the work.
ASSIGNEE_ACTION_WORDS=pls,please,FYA,take up,follow,confirm,check,look into,kindly
# Fields that must be present before approval. Options: subject,description,ticket_type,center,module,assignee.
# Keep ticket_type as the default unless the workflow requires additional fields.
REQUIRED_FIELDS=ticket_type

# Attachment Configuration
REDMINE_MAX_ATTACHMENT_MB=8
VIDEO_COMPRESSION_ENABLED=true
# Optional reference logo file: put the image to match at env/logo.png.
# Email images matching this reference are omitted; non-matches stay attached.
# Leave env/logo.png absent to keep email images without logo matching.
# Maximum average RGB pixel difference for a match (0-255; lower is stricter).
LOGO_IMAGE_MAX_PIXEL_DIFFERENCE=8

# Retry Configuration
RETRY_MAX_ATTEMPTS=4

# Use received email time for generated PDF names, or system time by default.
PDF_DATE_SOURCE=system
# Maximum image size embedded in generated PDFs (MB).
PDF_MAX_EMBED_MB=5
# Store full subject/description text in the local edit log; disabled by default for privacy.
EDIT_LOG_STORE_TEXT=false

# Local review UI
APP_MODE=ui
WEB_PORT=8000
WEB_AUTO_OPEN_BROWSER=true
